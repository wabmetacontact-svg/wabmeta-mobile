{
  "expo": {
    "name": "WabMeta",
    "slug": "wabmeta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wabmeta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#075E54"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wabmeta.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:wabmeta.com"
      ]
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#075E54"
      },
      "package": "com.wabmeta.app",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "wabmeta.com",
              "pathPrefix": "/mobile-callback"
            },
            {
              "scheme": "wabmeta"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#075E54"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WabMeta needs photo access to send images.",
          "cameraPermission": "WabMeta needs camera access."
        }
      ],
      "expo-sharing",
      "expo-video",
      "expo-audio",
      [
        "expo-contacts",
        {
          "contactsPermission": "WabMeta needs access to your contacts so you can import them into your contact list."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a1ffe55a-0c0f-48ff-900a-46cf795fc7d2"
      }
    },
    "owner": "sam1231"
  }
}
